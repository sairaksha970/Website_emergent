{
  "app_name": "Sairaksha Dairy Products Pvt Ltd",
  "app_type": "marketing_site",
  "archetype": "ORGANIC & EARTHY",
  "typography": {
    "heading_font": "Playfair Display, serif",
    "body_font": "Inter, sans-serif",
    "mono_font": "JetBrains Mono, monospace"
  },
  "colors": {
    "primary": "#1E4620",
    "primary_hover": "#143116",
    "secondary": "#D4A373",
    "accent": "#FAEDCD",
    "background": "#F4F1DE",
    "surface": "#FFFFFF",
    "text": "#283618",
    "muted": "#606C38"
  },
